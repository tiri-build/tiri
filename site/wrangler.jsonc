// tiri.build: a static site served as a Cloudflare Worker with static assets.
// Only /download/* runs src/worker.js, which counts downloads without keeping anything about who downloaded.
// The Chinese pages (public/zh-hans, public/zh-hant) are written from the English ones by i18n/build.mjs.
// Deploy from this folder with: npm run deploy
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tiri-site",
  "compatibility_date": "2026-11-01",
  "main": "src/worker.js",
  "build": { "command": "node i18n/build.mjs", "watch_dir": ["public", "i18n"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/download/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "tiri.build", "custom_domain": true },
    { "pattern": "www.tiri.build", "custom_domain": true }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "tiri-downloads", "database_id": "355ddc48-98ef-4114-a723-bc3abc987070" }],
  "workers_dev": false,
  "preview_urls": false
}
